/* pages/admin/admin.wxss */
.container {
  padding: 32rpx;
}

.order-info {
  flex: 1;
}

.user-info {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx dashed #E0DCD5;
}

.user-avatar {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  margin-right: 12rpx;
}

.user-name {
  font-size: 24rpx;
  color: #757575;
}

.order-meta {
  font-size: 24rpx;
  color: #757575;
  margin: 10rpx 0;
}

.order-price {
  font-size: 26rpx;
  color: #8B0000;
  font-weight: bold;
}

.actions {
  display: flex;
  gap: 20rpx;
  margin-top: 20rpx;
  justify-content: flex-end;
}

.actions button {
  margin: 0;
}

/* Stats */
.stats-card {
  margin-bottom: 30rpx;
}

.stats-month {
  font-size: 32rpx;
  font-weight: bold;
  color: #8B0000;
  margin-bottom: 20rpx;
  border-bottom: 1rpx solid #E0DCD5;
  padding-bottom: 10rpx;
}

.stats-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
}

.stats-item {
  display: flex;
  flex-direction: column;
}

.stats-item .label {
  font-size: 24rpx;
  color: #757575;
}

.stats-item .val {
  font-size: 30rpx;
  font-weight: bold;
}

.val.green { color: #4CAF50; }
.val.red { color: #F44336; }
