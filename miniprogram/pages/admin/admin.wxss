/* pages/admin/admin.wxss */
.container {
  padding: 32rpx;
}

/* Tabs */
.tabs {
  display: flex;
  margin-bottom: 30rpx;
  background: #fff;
  padding: 10rpx;
  border-radius: 8rpx;
  overflow-x: auto;
}

.tab {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  font-size: 28rpx;
  color: #757575;
  white-space: nowrap;
  min-width: 140rpx;
}

.tab.active {
  color: #8B0000;
  font-weight: bold;
  border-bottom: 4rpx solid #8B0000;
}

/* Common Card */
.card {
  background: #ffffff;
  border-radius: 12rpx;
  padding: 30rpx;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.05);
  margin-bottom: 24rpx;
}

.order-info {
  flex: 1;
}

.user-info {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx dashed #E0DCD5;
}

.user-avatar {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  margin-right: 12rpx;
}

.user-name {
  font-size: 24rpx;
  color: #757575;
}

.order-meta {
  font-size: 24rpx;
  color: #757575;
  margin: 10rpx 0;
}

.order-price {
  font-size: 26rpx;
  color: #8B0000;
  font-weight: bold;
}

.actions {
  display: flex;
  gap: 20rpx;
  margin-top: 20rpx;
  justify-content: flex-end;
}

.actions button {
  margin: 0;
}

/* Stats */
.stats-card {
  margin-bottom: 30rpx;
}

.stats-month {
  font-size: 32rpx;
  font-weight: bold;
  color: #8B0000;
  margin-bottom: 20rpx;
  border-bottom: 1rpx solid #E0DCD5;
  padding-bottom: 10rpx;
}

.stats-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
}

.stats-item {
  display: flex;
  flex-direction: column;
}

.stats-item .label {
  font-size: 24rpx;
  color: #757575;
}

.stats-item .val {
  font-size: 30rpx;
  font-weight: bold;
}

.val.green { color: #4CAF50; }
.val.red { color: #F44336; }

/* Product List (Recipe & Style) */
.btn-add {
  background-color: #8B0000;
  color: #fff;
  margin-bottom: 30rpx;
  font-size: 30rpx;
}

.product-card {
  display: flex;
  flex-direction: column;
}

.product-img {
  width: 100%;
  height: 300rpx;
  border-radius: 8rpx;
  margin-bottom: 20rpx;
  background-color: #f8f8f8;
}

.product-info {
  flex: 1;
}

.product-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 10rpx;
}

.product-desc {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 10rpx;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.product-meta {
  font-size: 24rpx;
  color: #8B0000;
  font-weight: bold;
}

/* Modal */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0,0,0,0.6);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.modal-content {
  width: 600rpx;
  max-height: 80vh;
  overflow-y: auto;
}

.modal-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  text-align: center;
  margin-bottom: 30rpx;
}

.form-group {
  margin-bottom: 24rpx;
}

.form-label {
  font-size: 28rpx;
  color: #333;
  margin-bottom: 10rpx;
  font-weight: bold;
}

.input {
  height: 80rpx;
  border: 1rpx solid #E0DCD5;
  border-radius: 8rpx;
  padding: 0 20rpx;
  margin-bottom: 0; /* Let form-group handle spacing */
  font-size: 28rpx;
}

.textarea {
  width: 100%;
  height: 160rpx;
  border: 1rpx solid #E0DCD5;
  border-radius: 8rpx;
  padding: 20rpx;
  margin-bottom: 0; /* Let form-group handle spacing */
  font-size: 28rpx;
  box-sizing: border-box;
}

.modal-actions {
  display: flex;
  justify-content: space-between;
  margin-top: 30rpx;
}

.upload-area {
  text-align: center;
  margin-bottom: 30rpx;
  border: 2rpx dashed #E0DCD5;
  padding: 20rpx;
  border-radius: 8rpx;
}

.upload-img {
  width: 160rpx;
  height: 160rpx;
  margin-bottom: 10rpx;
}

.upload-tip {
  font-size: 24rpx;
  color: #999;
}
