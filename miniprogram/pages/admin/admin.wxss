/* pages/admin/admin.wxss */
.container {
  padding: 32rpx;
  background-color: #F9F6F2; /* 宣纸色背景 */
  min-height: 100vh;
}

/* Tabs */
.tabs {
  display: flex;
  margin-bottom: 30rpx;
  background: #fff;
  padding: 10rpx;
  border-radius: 8rpx;
  box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.05);
}

.tab {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  font-size: 28rpx;
  color: #757575;
  white-space: nowrap;
  min-width: 140rpx;
  transition: all 0.3s ease;
}

.tab.active {
  color: #8B0000; /* 品牌红 */
  font-weight: bold;
  border-bottom: 4rpx solid #8B0000;
}

/* Common Card */
.card {
  background: #ffffff;
  border-radius: 12rpx;
  padding: 30rpx;
  box-shadow: 0 4rpx 20rpx rgba(139, 0, 0, 0.05); /* 微弱的红色阴影 */
  margin-bottom: 24rpx;
  border: 1rpx solid rgba(212, 175, 55, 0.2); /* 金色边框点缀 */
}

/* ... existing order styles ... */
.order-info {
  flex: 1;
}

.user-info {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx dashed #E0DCD5;
}

.user-avatar {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  margin-right: 12rpx;
}

.user-name {
  font-size: 24rpx;
  color: #757575;
}

.order-meta {
  font-size: 24rpx;
  color: #757575;
  margin: 10rpx 0;
}

.order-price {
  font-size: 26rpx;
  color: #8B0000;
  font-weight: bold;
}

.actions {
  display: flex;
  gap: 20rpx;
  margin-top: 20rpx;
  justify-content: flex-end;
}

.actions button {
  margin: 0;
  background-color: #fff;
  border: 1rpx solid #D4AF37; /* 金色边框按钮 */
  color: #333;
}

/* Stats */
.stats-card {
  margin-bottom: 30rpx;
}

.stats-month {
  font-size: 32rpx;
  font-weight: bold;
  color: #8B0000;
  margin-bottom: 20rpx;
  border-bottom: 1rpx solid #D4AF37; /* 金色分割线 */
  padding-bottom: 10rpx;
}

.stats-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
}

.stats-item {
  display: flex;
  flex-direction: column;
  padding: 16rpx;
  background-color: #FAFAFA;
  border-radius: 8rpx;
}

.stats-item.clickable:active {
  background-color: #F0E6E6; /* 点击反馈 */
}

.stats-item .label {
  font-size: 24rpx;
  color: #757575;
  margin-bottom: 8rpx;
}

.stats-item .val {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.val.green { color: #2E7D32; } /* 深绿，更稳重 */
.val.red { color: #8B0000; } /* 品牌红 */

.empty-tip {
  text-align: center;
  color: #999;
  padding: 40rpx;
  font-size: 28rpx;
}

/* ... existing product styles ... */
.btn-add {
  background-color: #8B0000;
  color: #fff;
  margin-bottom: 30rpx;
  font-size: 30rpx;
  border: none;
}

.product-card {
  display: flex;
  flex-direction: column;
}

.product-img {
  width: 100%;
  height: 300rpx;
  border-radius: 8rpx;
  margin-bottom: 20rpx;
  background-color: #f8f8f8;
}

.product-info {
  flex: 1;
}

.product-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 10rpx;
}

.product-desc {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 10rpx;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.product-meta {
  font-size: 24rpx;
  color: #8B0000;
  font-weight: bold;
}

/* Modal */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0,0,0,0.6);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.modal-content {
  width: 600rpx;
  max-height: 80vh;
  overflow-y: auto;
  background: #FBF9F2; /* 弹窗也用宣纸色 */
}

.modal-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #8B0000;
  text-align: center;
  margin-bottom: 30rpx;
}

.form-group {
  margin-bottom: 24rpx;
}

.form-label {
  font-size: 28rpx;
  color: #333;
  margin-bottom: 10rpx;
  font-weight: bold;
}

.input {
  height: 80rpx;
  border: 1rpx solid #D4AF37; /* 金色输入框 */
  border-radius: 8rpx;
  padding: 0 20rpx;
  margin-bottom: 0;
  font-size: 28rpx;
  background: #fff;
}

.textarea {
  width: 100%;
  height: 160rpx;
  border: 1rpx solid #D4AF37;
  border-radius: 8rpx;
  padding: 20rpx;
  margin-bottom: 0;
  font-size: 28rpx;
  box-sizing: border-box;
  background: #fff;
}

.modal-actions {
  display: flex;
  justify-content: space-between;
  margin-top: 30rpx;
}

.upload-area {
  text-align: center;
  margin-bottom: 30rpx;
  border: 2rpx dashed #D4AF37;
  padding: 20rpx;
  border-radius: 8rpx;
  background: #fff;
}

.upload-img {
  width: 160rpx;
  height: 160rpx;
  margin-bottom: 10rpx;
}

.upload-tip {
  font-size: 24rpx;
  color: #999;
}
