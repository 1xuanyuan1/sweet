/* pages/login/login.wxss */
.container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 100vh;
  background-color: #FBF9F2;
  padding: 40rpx;
}

.header {
  text-align: center;
  margin-bottom: 80rpx;
}

.logo {
  width: 180rpx;
  height: 180rpx;
  border-radius: 50%;
  border: 4rpx solid #B89650;
  margin-bottom: 30rpx;
}

.brand-name {
  font-size: 48rpx;
  font-weight: bold;
  color: #8B0000;
  letter-spacing: 4rpx;
}

.brand-slogan {
  font-size: 26rpx;
  color: #757575;
  margin-top: 16rpx;
}

.login-card {
  width: 100%;
  max-width: 600rpx;
  background: #fff;
  border-radius: 20rpx;
  padding: 60rpx 40rpx;
  box-shadow: 0 8rpx 30rpx rgba(0,0,0,0.08);
  text-align: center;
}

.title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 16rpx;
}

.desc {
  font-size: 26rpx;
  color: #999;
  margin-bottom: 60rpx;
}

.avatar-wrapper {
  padding: 0;
  width: 160rpx !important;
  height: 160rpx !important;
  border-radius: 50%;
  margin: 0 auto 40rpx;
  background: none;
  border: 2rpx solid #E0DCD5;
  position: relative;
  overflow: hidden;
}

.avatar {
  width: 100%;
  height: 100%;
}

.avatar-tip {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  background: rgba(0,0,0,0.5);
  color: #fff;
  font-size: 20rpx;
  padding: 4rpx 0;
}

.nickname-input {
  height: 90rpx;
  border-bottom: 2rpx solid #E0DCD5;
  margin-bottom: 60rpx;
  font-size: 32rpx;
  text-align: center;
}

.btn-primary {
  background-color: #8B0000;
  color: #ffffff;
  border-radius: 45rpx;
  font-size: 34rpx;
  padding: 20rpx 0;
  width: 100% !important;
  font-weight: bold;
}
