/* index.wxss */
.container {
  background-color: #FBF9F2;
  min-height: 100vh;
  padding: 40rpx 32rpx;
}

.header {
  text-align: center;
  margin-bottom: 60rpx;
}

.logo {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  border: 4rpx solid #B89650;
}

.brand-name {
  font-size: 44rpx;
  font-weight: bold;
  color: #8B0000;
  margin-top: 20rpx;
  letter-spacing: 4rpx;
}

.brand-slogan {
  font-size: 24rpx;
  color: #757575;
  margin-top: 10rpx;
}

.card {
  background: #ffffff;
  border-radius: 12rpx;
  padding: 40rpx;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.05);
}

.form-item {
  margin-bottom: 40rpx;
}

.label {
  font-size: 28rpx;
  color: #2C2C2C;
  margin-bottom: 16rpx;
  font-weight: bold;
}

.picker {
  height: 80rpx;
  line-height: 80rpx;
  border-bottom: 2rpx solid #E0DCD5;
  font-size: 30rpx;
  color: #2C2C2C;
}

.picker.placeholder {
  color: #757575;
}

.style-preview {
  margin-top: 24rpx;
  text-align: left; /* 改为左对齐 */
}

.style-image {
  width: 160rpx; /* 稍微调小一点，更精致 */
  height: 160rpx;
  border-radius: 8rpx;
  border: 1rpx solid #E0DCD5;
  background-color: #F9F6F2;
}

.desc {
  font-size: 24rpx;
  color: #757575;
  margin-top: 12rpx;
  font-style: italic;
}

.input {
  height: 80rpx;
  border-bottom: 2rpx solid #E0DCD5;
  font-size: 30rpx;
}

.price-section {
  margin: 60rpx 0;
  text-align: center;
  border-top: 1rpx dashed #E0DCD5;
  padding-top: 40rpx;
}

.price-label {
  font-size: 24rpx;
  color: #757575;
}

.price-value {
  font-size: 56rpx;
  font-weight: bold;
  color: #8B0000;
  margin-top: 10rpx;
}

.btn-primary {
  background-color: #8B0000;
  color: #ffffff;
  border-radius: 40rpx;
  font-size: 32rpx;
  margin-top: 40rpx;
}

.footer-nav {
  margin-top: 80rpx;
  display: flex;
  justify-content: center;
  gap: 40rpx;
}

.nav-item {
  font-size: 28rpx;
  color: #B89650;
  text-decoration: underline;
}

/* Modal */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0,0,0,0.6);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 100;
}

.modal-content {
  width: 600rpx;
  text-align: center;
}

.modal-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #8B0000;
  margin-bottom: 10rpx;
}

.modal-desc {
  font-size: 26rpx;
  color: #757575;
  margin-bottom: 40rpx;
}

.avatar-wrapper {
  padding: 0;
  width: 120rpx !important;
  height: 120rpx !important;
  border-radius: 50%;
  margin: 0 auto 40rpx;
  background: none;
  border: 2rpx solid #E0DCD5;
}

.avatar {
  width: 100%;
  height: 100%;
  border-radius: 50%;
}

.nickname-input {
  height: 80rpx;
  border-bottom: 1rpx solid #E0DCD5;
  margin-bottom: 40rpx;
  font-size: 30rpx;
}
