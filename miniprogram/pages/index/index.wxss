/* index.wxss */
.container {
  background-color: #FBF9F2;
  min-height: 100vh;
  padding: 32rpx;
}

/* Gallery */
.gallery {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 24rpx;
  padding-bottom: 40rpx;
}

.style-item {
  background: #fff;
  border-radius: 12rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
}

.style-img {
  width: 100%;
  height: 340rpx;
  background-color: #f8f8f8;
}

.style-name {
  padding: 20rpx;
  text-align: center;
  font-size: 30rpx;
  color: #333;
  font-weight: bold;
}

/* Modal */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.6);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.modal-content {
  width: 600rpx;
  background: #fff;
  border-radius: 16rpx;
  padding: 40rpx;
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 40rpx;
}

.modal-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #8B0000;
}

.close-btn {
  font-size: 40rpx;
  color: #999;
  padding: 0 10rpx;
}

.form-item {
  margin-bottom: 30rpx;
}

.label {
  font-size: 28rpx;
  color: #333;
  margin-bottom: 16rpx;
  font-weight: bold;
}

.picker {
  height: 80rpx;
  line-height: 80rpx;
  border-bottom: 2rpx solid #E0DCD5;
  font-size: 30rpx;
  color: #2C2C2C;
}

.picker.placeholder {
  color: #757575;
}

.desc {
  font-size: 24rpx;
  color: #757575;
  margin-top: 12rpx;
  font-style: italic;
}

.input {
  height: 80rpx;
  border-bottom: 2rpx solid #E0DCD5;
  font-size: 30rpx;
}

.price-section {
  margin: 40rpx 0;
  text-align: center;
  border-top: 1rpx dashed #E0DCD5;
  padding-top: 30rpx;
}

.price-label {
  font-size: 24rpx;
  color: #757575;
}

.price-value {
  font-size: 56rpx;
  font-weight: bold;
  color: #8B0000;
  margin-top: 10rpx;
}

.btn-primary {
  background-color: #8B0000;
  color: #ffffff;
  border-radius: 40rpx;
  font-size: 32rpx;
  margin-top: 20rpx;
}