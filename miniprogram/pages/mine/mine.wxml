<!-- pages/mine/mine.wxml -->
<view class="container">
  <!-- User Profile Header -->
  <view class="header card">
    <image class="avatar" src="{{userInfo.avatarUrl || '/images/logo.png'}}"></image>
    <view class="info">
      <view class="nickname">{{userInfo.nickName || '未登录用户'}}</view>
      <view class="role" wx:if="{{userInfo.isAdmin}}">品牌主理人</view>
    </view>
  </view>

  <!-- Menu List -->
  <view class="menu-list card">
    <view class="menu-item" wx:if="{{userInfo.isAdmin}}" bindtap="goToAdmin">
      <view class="menu-left">
        <text class="icon">🔧</text>
        <text class="text">后台管理</text>
      </view>
      <text class="arrow">></text>
    </view>
    
    <button class="menu-item btn-reset" open-type="contact">
      <view class="menu-left">
        <text class="icon">💬</text>
        <text class="text">联系客服</text>
      </view>
      <text class="arrow">></text>
    </button>

    <view class="menu-item" bindtap="contactSupport">
      <view class="menu-left">
        <text class="icon">ℹ️</text>
        <text class="text">关于我们</text>
      </view>
      <text class="arrow">></text>
    </view>
  </view>

  <view class="footer">
    <view class="copyright">和熹香堂 · 非遗手工合香</view>
  </view>
</view>
