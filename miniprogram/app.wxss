/** app.wxss **/
page {
  background-color: #FBF9F2;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, 'Open Sans', 'Helvetica Neue', sans-serif;
}

.container {
  padding: 32rpx;
}

.card {
  background: #ffffff;
  border-radius: 12rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.05);
}

.btn-primary {
  background-color: #8B0000;
  color: #ffffff;
}

.status-pending { color: #B89650; }
.status-confirmed { color: #2C2C2C; font-weight: bold; }
.status-paid { color: #4CAF50; }
.status-shipped { color: #2196F3; }

/* Admin Tabs */
.tabs {
  display: flex;
  margin-bottom: 40rpx;
  border-bottom: 1rpx solid #E0DCD5;
}

.tab {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  font-size: 28rpx;
  color: #757575;
}

.tab.active {
  color: #8B0000;
  border-bottom: 4rpx solid #8B0000;
  font-weight: bold;
}
